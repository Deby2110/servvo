# ============================================================
# ENVIRONMENT VARIABLES - salin file ini menjadi `.env`
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# URL origin client (untuk CORS & link WhatsApp)
CLIENT_URL=http://localhost:5173

# Secret JWT (WAJIB ganti di produksi)
JWT_SECRET=ganti-ini-dengan-string-acak-yang-panjang
JWT_REFRESH_SECRET=ganti-ini-dengan-string-acak-lainnya
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Kredensial admin awal untuk seed (ganti saat pertama login)
ADMIN_EMAIL=admin@servvo-ntt.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrator SERVVO NTT

# Pengaturan penawaran
INQUIRY_ENABLED=true
WHATSAPP_NUMBER=6281234567890

# Database (SQLite untuk development, ubah ke PostgreSQL untuk produksi)
# Contoh PostgreSQL: postgresql://user:password@localhost:5432/servvo?schema=public
DATABASE_URL="file:./dev.db"

# Upload
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_PDF_MB=10
